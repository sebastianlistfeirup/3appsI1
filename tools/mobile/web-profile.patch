+"use client";
+
+import { useSyncExternalStore } from "react";
+const ROUTE_KEY = "view";
+const EVENT = "studio-web-demo-navigation";
+
+/** Keep static-demo bookmarks on the real index document, preserving query/hash. */
+export function webDemoHref(href: string): string {
+  if (!href.startsWith("/") || href.startsWith("//")) return href;
+  const url = new URL(href, "https://studio.invalid");
+  if (url.pathname !== "/") url.searchParams.set(ROUTE_KEY, url.pathname);
+  else url.searchParams.delete(ROUTE_KEY);
+  const search = url.searchParams.toString();
+  return "/" + (search ? "?" + search : "") + url.hash;
+}
+function navigate(href: string, replace = false) {
+  const target = webDemoHref(href);
+  if (replace) window.history.replaceState(null, "", target);
+  else window.history.pushState(null, "", target);
+  window.dispatchEvent(new Event(EVENT));
+  window.dispatchEvent(new HashChangeEvent("hashchange"));
+  if (!window.location.hash) window.scrollTo({ top: 0, behavior: "instant" });
+}
+const router = {
+  push: (href: string) => navigate(href),
+  replace: (href: string) => navigate(href, true),
+  back: () => window.history.back(),
+};
+export function useRouter() {
+  return router;
+}
+function subscribe(listener: () => void) {
+  window.addEventListener(EVENT, listener);
+  window.addEventListener("popstate", listener);
+  return () => {
+    window.removeEventListener(EVENT, listener);
+    window.removeEventListener("popstate", listener);
+  };
+}
+function snapshot() {
+  const path = new URLSearchParams(window.location.search).get(ROUTE_KEY);
+  return path?.startsWith("/") && !path.startsWith("//") ? path : "/";
+}
+export function usePathname() {
+  return useSyncExternalStore(subscribe, snapshot, () => "/");
+}
